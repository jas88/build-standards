<!--
  Library Repository Target Framework Pattern

  This pattern is for repositories that contain only library projects (no executables).
  It follows these conventions:
  - All projects (except Tests, Benchmarks, Source Generators) are libraries → multi-target (all non-EOL)
  - Tests (*Tests, *.Test) and Benchmarks are single-target (latest LTS)
  - Source Generators target netstandard2.0 (required by Roslyn)

  Example repos that should use this pattern:
  - FAnsiSql (database abstraction library)
  - DicomTypeTranslation (DICOM type conversion library)
  - CsvHandler (CSV processing library)
  - libarchive.net (libarchive wrapper library)
-->
<Project>

  <!-- Test/benchmark naming convention; keep in sync with test detection in Directory.Build.props.shared -->
  <PropertyGroup>
    <_BuildStandardsIsTestOrBenchmark Condition="$(MSBuildProjectName.EndsWith('Tests')) OR $(MSBuildProjectName.EndsWith('.Test')) OR $(MSBuildProjectName.Contains('Benchmark'))">true</_BuildStandardsIsTestOrBenchmark>
  </PropertyGroup>

  <!--
    Target Framework Configuration for Library Repositories

    Logic:
    1. Libraries (most projects) → multi-target
    2. Tests, Benchmarks → single-target; Source Generators → netstandard2.0
  -->

  <!-- Library projects: Default to multi-target -->
  <PropertyGroup Condition="'$(_BuildStandardsIsTestOrBenchmark)' != 'true' AND !$(MSBuildProjectName.Contains('SourceGenerator'))">
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
  </PropertyGroup>

  <!-- Tests and Benchmarks: Always single-target -->
  <PropertyGroup Condition="'$(_BuildStandardsIsTestOrBenchmark)' == 'true'">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!--
    Source Generators: must target netstandard2.0 - Roslyn loads generators into the
    compiler process (including .NET Framework-hosted Visual Studio), so newer TFMs fail to load.
    Excludes their own Tests/Benchmarks projects, which run on .NET.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.Contains('SourceGenerator')) AND '$(_BuildStandardsIsTestOrBenchmark)' != 'true'">
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

</Project>