<!--
  Executable Repository Target Framework Pattern

  This pattern is for repositories that contain executable projects.
  It follows these conventions:
  - Projects WITHOUT dots in their name are treated as executables → single-target (latest)
  - Projects WITH dots in their name are treated as libraries → multi-target (all non-EOL)
  - Tests (*Tests, *.Test) and Benchmarks are single-target (latest LTS)
  - Source Generators target netstandard2.0 (required by Roslyn)

  Example repos that should use this pattern:
  - SynthEHR (contains SynthEHR.exe)
  - RDMP (contains rdmp.exe)
  - PACSify (contains PACSify.exe)
-->
<Project>

  <!-- Test/benchmark naming convention; keep in sync with test detection in Directory.Build.props.shared -->
  <PropertyGroup>
    <_BuildStandardsIsTestOrBenchmark Condition="$(MSBuildProjectName.EndsWith('Tests')) OR $(MSBuildProjectName.EndsWith('.Test')) OR $(MSBuildProjectName.Contains('Benchmark'))">true</_BuildStandardsIsTestOrBenchmark>
  </PropertyGroup>

  <!--
    Target Framework Configuration for Executable Repositories

    Logic:
    1. Projects WITHOUT dots AND NOT Tests/Benchmarks = executables → single-target
    2. Projects WITH dots AND NOT SourceGenerators = libraries → multi-target
    3. Tests, Benchmarks = single-target; Source Generators = netstandard2.0
  -->

  <!-- Executable projects: No dots, not Tests/Benchmarks, not Source Generators -->
  <PropertyGroup Condition="!$(MSBuildProjectName.Contains('.')) AND '$(_BuildStandardsIsTestOrBenchmark)' != 'true' AND !$(MSBuildProjectName.Contains('SourceGenerator'))">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Library projects: Have dots, not Tests/Benchmarks/Source Generators -->
  <PropertyGroup Condition="$(MSBuildProjectName.Contains('.')) AND '$(_BuildStandardsIsTestOrBenchmark)' != 'true' AND !$(MSBuildProjectName.Contains('SourceGenerator'))">
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
  </PropertyGroup>

  <!-- Tests and Benchmarks: Always single-target -->
  <PropertyGroup Condition="'$(_BuildStandardsIsTestOrBenchmark)' == 'true'">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!--
    Source Generators: must target netstandard2.0 - Roslyn loads generators into the
    compiler process (including .NET Framework-hosted Visual Studio), so newer TFMs fail to load.
    Excludes their own Tests/Benchmarks projects, which run on .NET.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.Contains('SourceGenerator')) AND '$(_BuildStandardsIsTestOrBenchmark)' != 'true'">
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

</Project>