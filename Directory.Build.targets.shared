<Project>
  <!--
    Shared .NET Build Targets for jas88 projects
    Import this in your repo's Directory.Build.targets:

    <Import Project="build-standards/Directory.Build.targets.shared" />

    These properties must be in a targets file (not props) because they
    depend on $(TargetFramework) which is not set until after props files.
  -->

  <!-- AOT and Trimming Compatibility (only for frameworks that support it) -->
  <!-- Condition ensures property isn't set for netstandard/older frameworks -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <!--
    IsTestProject set in the csproj body is only visible here, too late for the MTP
    settings in Directory.Build.props.shared. Flag it rather than silently using VSTest.
    Runs once per project: in the outer build when multi-targeted, not per inner TFM.
  -->
  <Target Name="_BuildStandardsCheckTestDetection" BeforeTargets="Build"
          Condition="'$(IsTestProject)' == 'true' AND '$(UseMicrosoftTestingPlatform)' == 'true' AND '$(_BuildStandardsMtpApplied)' != 'true' AND ('$(TargetFrameworks)' == '' OR '$(IsCrossTargetingBuild)' == 'true')">
    <Warning Code="BS0001" Text="$(MSBuildProjectName) sets IsTestProject in its project file, after build-standards applied its test settings, so it is not using Microsoft Testing Platform. Name it *.Tests, move it under tests/, set IsTestProject before importing Directory.Build.props.shared, or set UseMicrosoftTestingPlatform=false to stay on VSTest." />
  </Target>
</Project>
