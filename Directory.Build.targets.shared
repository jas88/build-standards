<Project>
  <!--
    Shared .NET Build Targets for jas88 projects
    Import this in your repo's Directory.Build.targets:

    <Import Project="build-standards/Directory.Build.targets.shared" />

    These properties must be in a targets file (not props) because they
    depend on $(TargetFramework) which is not set until after props files.
  -->

  <!-- AOT and Trimming Compatibility (only for frameworks that support it) -->
  <!-- Condition ensures property isn't set for netstandard/older frameworks -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <!--
    IsTestProject set in the csproj body, or by a package such as Microsoft.NET.Test.Sdk, is
    visible only here, too late for the MTP settings in Directory.Build.props.shared. Flag it
    rather than silently leaving those settings out.
    Runs once per project: in the outer build when multi-targeted, not per inner TFM.
  -->
  <Target Name="_BuildStandardsCheckTestDetection" BeforeTargets="Build"
          Condition="'$(IsTestProject)' == 'true' AND '$(UseMicrosoftTestingPlatform)' == 'true' AND '$(_BuildStandardsMtpApplied)' != 'true' AND ('$(TargetFrameworks)' == '' OR '$(IsCrossTargetingBuild)' == 'true')">
    <Warning Code="BS0001" Text="$(MSBuildProjectName) is a test project, but IsTestProject was set after Directory.Build.props.shared was imported, so build-standards did not apply its test settings: EnableNUnitRunner=true, OutputType=Exe and the Microsoft.Testing.Extensions.CodeCoverage package reference. Set IsTestProject=true before that import (in the repo's Directory.Build.props or a nested one), name the project *.Tests or *.Test, or put it in a folder under tests/ or test/; to stay on VSTest, set UseMicrosoftTestingPlatform=false instead." />
  </Target>
</Project>
